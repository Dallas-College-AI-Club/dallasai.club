{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/leaderboard.mjs": {
      "maxDuration": 15
    },
    "api/forms.mjs": {
      "maxDuration": 60,
      "includeFiles": "generated/events.json"
    },
    "api/admin.mjs": {
      "maxDuration": 60
    },
    "api/maintenance.mjs": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "15 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    }
  ]
}
