# Use the forms runtime role; never a database-owner connection in Vercel.
FORMS_DATABASE_URL=
FORM_TOKEN_SECRET=
# Neon Auth email-code sign-in for officers. Required: without it, admin
# sign-in returns 503. Give each officer the admin role in Neon first.
NEON_AUTH_URL=
NEON_AUTH_COOKIE_SECRET=
AUTH_BASE_URL=https://dallasai-leaderboard.vercel.app
ADMIN_EMAILS=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Optional server-only Short.io settings for officer-created sharing links.
SHORT_IO_API_KEY=
SHORT_IO_DOMAIN=go.dallasai.club
# Optional fallback for new links when Short.io is unavailable.
TINYURL_API_TOKEN=
# Optional exact origins for preview frontend testing.
FORMS_ALLOWED_ORIGINS=
# Keep existing DATABASE_URL and SESSION_SECRET for the leaderboard.
# Forms confirm on screen; no form email service is used.
# Managed Neon Auth delivers sign-in codes separately.
