{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/leaderboard.mjs": {
      "maxDuration": 15
    },
    "api/forms.mjs": {
      "maxDuration": 60,
      "includeFiles": "generated/events.json"
    },
    "api/admin.mjs": {
      "maxDuration": 60,
      "includeFiles": "generated/events.json"
    },
    "api/events.mjs": {
      "maxDuration": 30,
      "includeFiles": "generated/events.json"
    },
    "api/auth.mjs": {
      "maxDuration": 30
    },
    "api/maintenance.mjs": {
      "maxDuration": 30
    },
    "api/surveys.mjs": {
      "maxDuration": 30,
      "includeFiles": "generated/events.json"
    },
    "api/custom-surveys.mjs": {
      "maxDuration": 30,
      "includeFiles": "surveys/advisor-definition.json"
    }
  },
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "15 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/surveys/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; frame-src https://dallasai.club; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    }
  ]
}
